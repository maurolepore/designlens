#!/bin/bash

# designlens main entry point
# Routes commands to lib scripts

set -e

# Get the directory where this script is installed
SCRIPT_DIR="$( cd "$( dirname "$(readlink -f "${BASH_SOURCE[0]}")" )" && pwd )"
LIB_DIR="$SCRIPT_DIR/../lib"

# Source colors and logo
source "$LIB_DIR/colors.sh"
source "$LIB_DIR/logo.sh"

# Help text
show_help() {
  show_logo

  cat << 'EOF'
designlens - Design history and architectural decision tracking

USAGE:
  designlens <command> [options]

COMMANDS:
  help                Show this help message
  init                Initialize a project (run once)
  status              Show current project state
  config              Manage designlens configuration
  version             Show installed version
  add-agent           Add configuration for additional agents
  new-stage           Create the next spec stage directory and plan.md
  lib                 Source library functions (e.g., designlens lib is-empty)
  update              Update designlens to latest version
  uninstall           Uninstall designlens from system

WORKFLOW COMMANDS (native agent slash commands, installed by 'init'):
  /designlens.help            Show help inside the agent
  /designlens.status          Show and remind agent of current project state
  /designlens.new-stage       1. Gather requirements and create a new stage
  /designlens.make-tasks      2. Generate tasks.md from the current plan.md
  /designlens.implement       3. Implement all tasks in the current tasks.md
  /designlens.retrospective   4. Generate transcript and design decisions

EXAMPLES:
  designlens init
  designlens new-stage "add validation" "add-validation"
  designlens status
  designlens config show
  designlens config set auto_commit true

For full documentation, see the docs/conventions.md in the designlens repo.
EOF
}

# Route commands
case "$1" in
  init)
    source "$LIB_DIR/init.sh"
    spec_init
    ;;
  add-agent)
    source "$LIB_DIR/add-agent.sh"
    spec_add_agent
    ;;
  new-stage)
    source "$LIB_DIR/new-stage.sh"
    spec_new_stage "$2" "$3"
    ;;
  status)
    source "$LIB_DIR/status.sh"
    spec_status
    ;;
  version|-v|--version)
    METADATA_FILE="$SCRIPT_DIR/../designlens.json"
    if [ -f "$METADATA_FILE" ]; then
      VERSION=$(grep -o '"Version": *"[^"]*"' "$METADATA_FILE" | cut -d'"' -f4)
      if [ -n "$VERSION" ]; then
        echo "designlens $VERSION"
      else
        echo "designlens (version unknown)"
      fi
    else
      echo "designlens (version unknown)"
    fi
    ;;
  lib)
    LIBRARY="$2"
    if [ -z "$LIBRARY" ]; then
      echo "Usage: designlens lib <library-name>" >&2
      echo "Available: is-empty, commits-since-stage" >&2
      exit 1
    fi
    case "$LIBRARY" in
      is-empty)
        source "$LIB_DIR/is-empty.sh"
        echo "DESIGNLENS_PATHS='.designlens.json AGENTS.md specs .git .claude .opencode'"
        declare -f is_designlens_path
        declare -f check_git_history
        declare -f check_filesystem
        declare -f is_project_empty
        ;;
      commits-since-stage)
        source "$LIB_DIR/commits-since-stage.sh"
        commits_since_stage
        ;;
      *)
        echo "Unknown library: $LIBRARY" >&2
        echo "Available: is-empty, commits-since-stage" >&2
        exit 1
        ;;
    esac
    ;;
  update)
    source "$LIB_DIR/update.sh"
    spec_update
    ;;
  config)
    source "$LIB_DIR/config.sh"
    case "$2" in
      show|view|get)
        spec_config_show
        ;;
      set)
        if [ -z "$3" ] || [ -z "$4" ]; then
          echo "Usage: designlens config set <key> <value>"
          echo "Example: designlens config set auto_commit true"
          exit 1
        fi
        spec_config_set "$3" "$4"
        ;;
      reset)
        spec_config_reset
        ;;
      *)
        spec_config_help
        ;;
    esac
    ;;
  uninstall)
    source "$LIB_DIR/uninstall.sh"
    spec_uninstall
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    if [ -z "$1" ]; then
      show_help
    else
      echo "Error: Unknown command: $1"
      echo ""
      show_help
      exit 1
    fi
    ;;
esac
